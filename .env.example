# IBM Quantum Configuration
IBM_QUANTUM_TOKEN=your_ibm_quantum_token_here
IBM_QUANTUM_CHANNEL=ibm_quantum

# Wallet Password (can also be passed via command line)
WALLET_PASSWORD=your_secure_password_here

# QRNG API Configuration (for qrng_api.py)
# x402 Payment Configuration
X402_FACILITATOR_URL=https://facilitator.x402.rs
X402_RECEIVER_ADDRESS=0xYourWalletAddressHere
X402_DEFAULT_NETWORK=base

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
